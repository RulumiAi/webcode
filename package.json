{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode design",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:i18n": "tsx --test src/i18n.test.ts",
    "test:membership": "tsx --test src/data/membershipProducts.test.ts",
    "test:membership-badges": "tsx --test src/components/MembershipBadge.test.ts",
    "test:sidebar-brand": "tsx --test src/components/SidebarBrandLink.test.ts",
    "test:payments": "tsx --test src/paymentApi.test.ts src/data/membershipProducts.test.ts src/upgradeReturnNavigation.test.ts",
    "test:media-unlock": "tsx --test src/mediaUnlockApi.test.ts src/apiCharacterMapping.test.ts",
    "test:create-presets": "tsx --test src/data/createCharacterPresets.test.ts",
    "test:create-voices": "tsx --test src/data/createCharacterVoices.test.ts",
    "test:expandable-description": "tsx --test src/components/ExpandableDescription.test.ts",
    "test:create-assets": "tsx --test src/data/createCharacterAssets.test.ts",
    "verify:create-assets-dist": "tsx scripts/verify-create-character-dist.ts",
    "verify:create-media": "\"..\\.venv\\Scripts\\python.exe\" scripts/verify-optimized-media.py --scope create-character",
    "verify:optimized-media": "\"..\\.venv\\Scripts\\python.exe\" scripts/verify-optimized-media.py",
    "optimize:media": "python scripts/optimize-media.py",
    "test:generation-polling": "tsx --test src/utils/generationPolling.test.ts",
    "test:wizard-generate": "tsx --test src/wizardGenerate.test.ts",
    "test:user-errors": "tsx --test src/utils/userError.test.ts",
    "test:chat-scroll": "tsx --test src/utils/chatScroll.test.ts",
    "test:chat-text": "tsx --test src/utils/roleplayText.test.ts",
    "test:generator-presets": "tsx --test src/utils/generatorPresets.test.ts",
    "test:generator-scroll": "tsx --test src/utils/presetCarouselScroll.test.ts",
    "test:name-availability": "tsx --test src/utils/nameAvailability.test.ts",
    "test:create-progress": "tsx --test src/utils/creationProgress.test.ts",
    "test:display-tags": "tsx --test src/displayTags.test.ts",
    "test:filter-tags": "tsx --test src/filterTags.test.ts",
    "test:cache": "tsx --test src/apiCache.test.ts src/chatTimelineCache.test.ts src/components/FeedCacheBehavior.test.ts src/utils/characterImageCache.test.ts",
    "test:api-mapping": "tsx --test src/apiCharacterMapping.test.ts",
    "test:favorites": "tsx --test src/favorites.test.ts",
    "dev:preview": "vite --host 0.0.0.0 --mode design",
    "build:preview": "vite build --mode design",
    "dev:server": "tsx server.ts",
    "test:discovery-runtime": "node scripts/test-discovery-runtime.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
